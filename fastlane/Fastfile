default_platform(:ios)
platform :ios do
  desc 'Upload the signed build; external review and invitation are separate visible steps'
  lane :upload do
    upload_to_testflight(
      api_key_path: ENV.fetch('ASC_API_KEY_JSON'),
      app_identifier: 'com.kang88.carcar',
      ipa: Dir[File.join(File.expand_path('..', __dir__), 'build/ios/ipa/*.ipa')].first || UI.user_error!('Signed IPA is missing'),
      skip_submission: true,
      skip_waiting_for_build_processing: false,
      wait_processing_timeout_duration: 1200,
      changelog: '홈에서 차량과 마지막 주차 위치를 더 또렷하게 확인할 수 있도록 정리했습니다. 주차 기록 버튼을 위치 바로 아래에 두고 사진 기록·차량 찾기 등 보조 기능을 분리했습니다. 주차 입력 중 선택한 위치와 저장 버튼을 하단에서 확인할 수 있으며, 작은 화면·큰 글자·키보드와 긴 입력값의 스크롤 동작을 개선했습니다.'
    )
  end
end
