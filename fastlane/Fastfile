default_platform(:ios)
platform :ios do
  desc 'Upload the signed build; external review and invitation are separate visible steps'
  lane :upload do
    upload_to_testflight(
      api_key_path: ENV.fetch('ASC_API_KEY_JSON'),
      app_identifier: 'com.kang88.carcar',
      ipa: Dir[File.join(File.expand_path('..', __dir__), 'build/ios/ipa/*.ipa')].first || UI.user_error!('Signed IPA is missing'),
      skip_submission: true,
      skip_waiting_for_build_processing: false,
      wait_processing_timeout_duration: 1200,
      changelog: '차자리의 앱 화면, 층수 아이콘과 위젯을 블루·슬레이트 색상으로 맞췄습니다. 주차 위치와 기록 버튼이 먼저 보이는 담백한 화면 구성을 유지하고, 작은 글자의 명암 대비를 높였습니다. 앱 이름과 TestFlight 표시 정보도 함께 점검했습니다.'
    )
  end
end
